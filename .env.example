# Copy to .env.local and enter values from your own Firebase and EmailJS projects.
# Vite exposes VITE_ variables in browser code. Never put private server keys here.
# Configure one EmailJS template for the form type, reference, sender, reply-to, and details fields.
# For the release form, set up a Form File Attachment using the input parameter name `petPhoto`.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set the administrator recipient in the EmailJS template dashboard, not in client code.
