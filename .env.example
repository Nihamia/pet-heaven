# Copy to .env.local and enter values from your own Firebase and EmailJS projects.
# Vite exposes VITE_ variables in browser code. Never put private server keys here.
# Configure the shared administrator and acknowledgement templates from docs/emailjs-templates.md.
# Release emails include the photo filename and size as text.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TEMPLATE_ADMIN=
VITE_EMAILJS_TEMPLATE_ACK=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional random cat photos: use a browser API key from https://thecatapi.com/.
VITE_CAT_API_KEY=

# Set the administrator recipient in the EmailJS template dashboard, not in client code.
